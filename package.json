{
  "name": "face-draw",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time face filters and face-controlled games that run entirely in the browser on your phone.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "node scripts/copy-wasm.mjs && vite --host",
    "build": "node scripts/copy-wasm.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "topology": "node scripts/gen-topology.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
